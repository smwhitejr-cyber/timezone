  <xs:simpleType name="CallingProcessIdentifier">
    <xs:annotation>
      <xs:documentation>Identifies the calling process. This is returned in the response success and failure to assist in determining where a message originated. Although this is free text, care should be taken to keep these values consistent and unique between callers - such as the full namespace and class name of the calling process.</xs:documentation>
    </xs:annotation>
